APP_NAME="CompanyAIChatbot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=company_ai_chatbot
DB_USERNAME=company_ai_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Chatbot (config/chatbot.php)
# --------------------------------------------------------------------------
CHATBOT_VERSION=0.1.0
CHATBOT_LOG_CHANNEL=chatbot
# CHATBOT_LOG_LEVEL defaults to LOG_LEVEL above if unset.

# --------------------------------------------------------------------------
# AI Service (config/ai.php) - used by App\Services\AIClient to reach the
# company's centralized AI HTTP endpoint (owned by IT - SharePoint,
# Excel sync, data ingestion, and the AI model itself all live behind
# this one service now). See docs/ai-client.md.
# --------------------------------------------------------------------------
AI_API_URL=http://10.10.10.15:8000
AI_TIMEOUT=120
AI_RETRIES=2
AI_RETRY_DELAY_MS=250

# --------------------------------------------------------------------------
# Ollama (config/ollama.php) - used by App\Services\OllamaClient, called
# directly by the separate /api/chat data-pipeline endpoint. Distinct
# from AI_API_URL above (the older web /chat pipeline's wrapper API) -
# see docs/data-pipeline-api.md.
# --------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_ATTEMPTS=2
OLLAMA_RETRY_DELAY_MS=500
OLLAMA_THINK=false
# OLLAMA_PROXY=http://proxy.example:8080
